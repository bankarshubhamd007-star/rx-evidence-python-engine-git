# ───────────────────────────────────────────────
# RX Evidence Engine — Environment Variables
# Copy this file to .env and fill in your keys.
# ───────────────────────────────────────────────

# ── Medical Data API Keys ──
TAVILY_API_KEY=your_tavily_api_key_here
PUBMED_API_KEY=your_pubmed_api_key_here
OPENFDA_API_KEY=your_openfda_api_key_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
OPENALEX_API_KEY=your_openalex_api_key_here

# ── LLM Provider Keys (choose one or both) ──
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Database Configuration ──
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB_NAME=your_db_name_here

# ── Auth Configuration ──
JWT_SECRET_KEY=change_this_to_a_long_random_string
CORS_ALLOWED_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
