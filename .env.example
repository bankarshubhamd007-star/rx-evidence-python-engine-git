# ───────────────────────────────────────────────
# RX Evidence Engine — Environment Variables
# ───────────────────────────────────────────────
# ── Medical Data API Keys ──
TAVILY_API_KEY=your_tavily_api_key_here
PUBMED_API_KEY=your_pubmed_api_key_here
OPENFDA_API_KEY=your_openfda_api_key_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
OPENALEX_API_KEY=your_openalex_api_key_here
# ── LLM Provider Keys (choose one or both) ──
LLM_MODEL_LOW=meta-llama/llama-3.1-8b-instruct
LLM_MODEL_MEDIUM=google/gemini-2.5-flash
LLM_MODEL_HIGH=meta-llama/llama-3.3-70b-instruct
OPENROUTER_API_KEY=your_openrouter_api_key_here
# ── MongoDB Config ──
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0"
MONGODB_DB_NAME="rx_evidence"
# ── Auth Configuration ──
JWT_SECRET_KEY=your_jwt_secret_key_here
CORS_ALLOWED_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CHROME_CLIENT_ID=your_google_chrome_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
